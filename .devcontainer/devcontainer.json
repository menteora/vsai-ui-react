{
  "name": "node-publish",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-20-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "openai.chatgpt"
      ]
    }
  },
  "postCreateCommand": "corepack enable && npm ci || npm install",
  "remoteUser": "node"
}
